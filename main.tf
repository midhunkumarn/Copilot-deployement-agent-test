# This configuration has been generated by the Azure Terraform plugin which utilizes Generative AI which may result in unintended or inaccurate configuration code. A human must validate that this configuration accomplishes the desired goal before applying the configuration.

data "azurerm_client_config" "current" {}

resource "azurerm_resource_group" "midhun_test" {
  name     = var.resource_group_name
  location = var.location

  tags = {
    environment = "test"
    owner       = "Bharath-MSDN"
    project     = "copilot-vm"
  }
}

resource "azurerm_virtual_network" "test_ci_mk" {
  name                = var.virtual_network_name
  location            = var.location
  resource_group_name = var.resource_group_name
  address_space       = ["10.0.0.0/16"]
}

resource "azurerm_subnet" "default" {
  name                 = "default"
  resource_group_name  = var.resource_group_name
  virtual_network_name = azurerm_virtual_network.test_ci_mk.name
  address_prefixes     = ["10.0.0.0/24"]
}

resource "azurerm_network_security_group" "copilot_test_NSG" {
  name                = "copilot-test-NSG"
  location            = var.location
  resource_group_name = var.resource_group_name

  security_rule {
    name                   = "Allow-RDP-From-AdminIP"
    description            = "Allow RDP from management IP (replace with your IP)."
    protocol               = "Tcp"
    source_address_prefix  = "203.0.113.4/32"
    destination_port_range = "3389"
    access                 = "Allow"
    priority               = 100
    direction              = "Inbound"
  }

  security_rule {
    name                   = "Deny-RDP-From-Internet"
    description            = "Deny RDP from Internet."
    protocol               = "Tcp"
    source_address_prefix  = "Internet"
    destination_port_range = "3389"
    access                 = "Deny"
    priority               = 200
    direction              = "Inbound"
  }
}

resource "azurerm_subnet" "test_ci_mk_default" {
  name                 = "default"
  resource_group_name  = var.resource_group_name
  virtual_network_name = azurerm_virtual_network.test_ci_mk.name
  address_prefixes     = ["10.0.1.0/24"]
}

resource "azurerm_network_interface" "copilot_test_nic" {
  name                = "copilot-test-NIC"
  location            = var.location
  resource_group_name = var.resource_group_name

  ip_configuration {
    name                          = "ipconfig1"
    subnet_id                     = azurerm_subnet.test_ci_mk_default.id
    private_ip_address_allocation = "Dynamic"
    primary                       = true
  }
}

resource "azurerm_network_interface_security_group_association" "copilot_test_nic_nsg" {
  network_interface_id      = azurerm_network_interface.copilot_test_nic.id
  network_security_group_id = azurerm_network_security_group.copilot_test_NSG.id
}

resource "random_password" "admin_password" {
  length  = 16
  special = true
}

resource "azurerm_windows_virtual_machine" "copilot_test_vm" {
  name                  = "copilot-test-VM"
  location              = var.location
  resource_group_name   = var.resource_group_name
  size                  = "Standard_D4as_v5"
  network_interface_ids = [azurerm_network_interface.copilot_test_nic.id]

  admin_username             = "azureuser"
  admin_password             = random_password.admin_password.result
  computer_name              = "copilotvm01"
  provision_vm_agent         = true
  automatic_updates_enabled  = true

  source_image_reference {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2022-datacenter"
    version   = "latest"
  }

  os_disk {
    name                 = "copilot-test-Disk"
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 128
  }

  tags = {
    environment = "test"
    owner       = "Bharath-MSDN"
  }
}